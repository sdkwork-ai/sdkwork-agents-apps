/* Shared app-bar / segment / state-card styles live in app.wxss. */

.feed-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.feed-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  background: var(--muted);
}

.feed-cover-fallback {
  height: 360rpx;
  font-size: 48rpx;
  color: var(--icon-default);
}

.feed-body {
  padding: 24rpx;
}

.feed-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

.feed-author {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.feed-likes {
  margin-left: 16rpx;
}
