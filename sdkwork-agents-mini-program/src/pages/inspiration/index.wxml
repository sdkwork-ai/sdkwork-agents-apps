<view class="page {{themeClass}}" style="padding-bottom: {{bottomInset}}px;">
  <view class="app-bar" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="app-bar-inner">
      <view class="app-bar-titles app-bar-titles-left">
        <text class="app-bar-title">{{t.title}}</text>
      </view>
      <view
        class="app-bar-avatar"
        bindtap="onOpenProfile"
        aria-role="button"
        aria-label="{{t.profileEntry}}"
      >
        <text class="app-bar-avatar-glyph">我</text>
      </view>
    </view>
  </view>

  <view class="content" style="margin-top: {{headerHeight}}px;">
    <view class="segments">
      <view
        class="segment {{segment === 'discover' ? 'is-active' : ''}}"
        data-segment="discover"
        bindtap="onSegmentTap"
        aria-role="button"
      >{{t.discover}}</view>
      <view
        class="segment {{segment === 'featured' ? 'is-active' : ''}}"
        data-segment="featured"
        bindtap="onSegmentTap"
        aria-role="button"
      >{{t.featured}}</view>
    </view>

    <view wx:if="{{status === 'loading'}}" class="status">{{t.loading}}</view>

    <view wx:elif="{{status === 'unavailable'}}" class="state-card">
      <text class="state-title">{{t.unavailable}}</text>
      <text class="state-detail">{{t.pullHint}}</text>
      <view class="state-actions">
        <view class="secondary-button" bindtap="onRetry" aria-role="button">{{t.retry}}</view>
      </view>
    </view>

    <view wx:elif="{{status === 'error'}}" class="state-card">
      <text class="state-title">{{t.loadFailed}}</text>
      <view class="state-actions">
        <view class="secondary-button" bindtap="onRetry" aria-role="button">{{t.retry}}</view>
      </view>
    </view>

    <view wx:elif="{{status === 'empty'}}" class="status">{{t.empty}}</view>

    <block wx:else>
      <text wx:if="{{countText}}" class="status status-note">{{countText}}</text>
      <view class="feed">
        <view wx:for="{{items}}" wx:key="id" class="feed-card">
          <image
            wx:if="{{item.coverUrl}}"
            class="feed-cover"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="tile-fallback feed-cover-fallback">✦</view>
          <view class="feed-body">
            <text class="card-title">{{item.title}}</text>
            <text wx:if="{{item.prompt}}" class="card-subtitle">{{item.prompt}}</text>
            <view class="feed-meta">
              <text wx:if="{{item.author}}" class="feed-author">{{item.author}}</text>
              <text wx:if="{{item.likesText}}" class="feed-likes">{{item.likesText}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
