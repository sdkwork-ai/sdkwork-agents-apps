/* Shared app-bar / banner / status styles live in app.wxss. */

.transcript {
  box-sizing: border-box;
  padding: 24rpx 32rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.empty-avatar {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  margin-bottom: 32rpx;
}

.empty-avatar-glyph {
  font-size: 56rpx;
  color: var(--icon-on-primary);
}

.empty-greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-muted);
}

.messages {
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.row-user {
  align-items: flex-end;
}

.row-assistant {
  align-items: flex-start;
}

/* Bubbles are tonal fills: white for the assistant, blue for the user. */
.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--surface);
}

.row-user .bubble {
  background: var(--primary);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text);
  word-break: break-all;
}

.row-user .bubble-text {
  color: var(--primary-on);
}

.bubble-cursor {
  color: var(--icon-active);
  font-size: 26rpx;
}

.bubble-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.reasoning {
  max-width: 78%;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--muted);
}

.reasoning-title {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.reasoning-body {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
  word-break: break-all;
}

.tools {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.tool {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-subtle);
}

.tool-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--accent);
}

.tool-status {
  font-size: 22rpx;
  color: var(--text-muted);
}

.tool-status-error {
  color: var(--danger);
}

/* Composer separates from the transcript by white fill, not a top line. */
.composer {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--surface);
}

.composer-mic {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.composer-mic-glyph {
  font-size: 34rpx;
  color: var(--icon-default);
}

.composer-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: var(--muted);
  font-size: 28rpx;
  color: var(--text);
}

.composer-send {
  margin-left: 12rpx;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--primary-on);
  font-size: 28rpx;
}

.composer-send:active {
  background: var(--primary-pressed);
}

.composer-send.is-disabled {
  background: var(--strong);
  color: var(--text-weak);
}
