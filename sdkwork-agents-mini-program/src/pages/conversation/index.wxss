/* Shared app-bar / banner / status styles live in app.wxss. */

.transcript {
  box-sizing: border-box;
  padding: 24rpx 32rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.empty-avatar {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0f766e;
  margin-bottom: 32rpx;
}

.empty-avatar-glyph {
  font-size: 56rpx;
  color: #ffffff;
}

.empty-greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #64748b;
}

.messages {
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.row-user {
  align-items: flex-end;
}

.row-assistant {
  align-items: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.row-user .bubble {
  background: #0f766e;
  border-color: #0f766e;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #0f172a;
  word-break: break-all;
}

.row-user .bubble-text {
  color: #ffffff;
}

.bubble-cursor {
  color: #0f766e;
  font-size: 26rpx;
}

.bubble-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.reasoning {
  max-width: 78%;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.reasoning-title {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.reasoning-body {
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
  word-break: break-all;
}

.tools {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.tool {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: #ecfeff;
}

.tool-name {
  flex: 1;
  font-size: 22rpx;
  color: #0e7490;
}

.tool-status {
  font-size: 22rpx;
  color: #64748b;
}

.tool-status-error {
  color: #dc2626;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.composer-mic {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.composer-mic-glyph {
  font-size: 34rpx;
  color: #64748b;
}

.composer-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #0f172a;
}

.composer-send {
  margin-left: 12rpx;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 28rpx;
}

.composer-send.is-disabled {
  background: #94a3b8;
}
