<view class="page {{themeClass}}" style="padding-bottom: {{bottomInset}}px;">
  <view class="app-bar" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="app-bar-inner">
      <view
        class="app-bar-back"
        bindtap="onBack"
        aria-role="button"
        aria-label="{{t.back}}"
      >‹</view>
      <view class="app-bar-titles app-bar-titles-left">
        <text class="app-bar-title">{{t.title}}</text>
      </view>
    </view>
  </view>

  <view class="content" style="margin-top: {{headerHeight}}px;">
    <view class="card identity-card">
      <text class="card-subtitle">{{t.identityTitle}}</text>
      <view class="identity-body">
        <button
          class="identity-avatar-button"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          aria-label="{{t.identityEdit}}"
        >
          <image
            wx:if="{{identity.avatarUrl}}"
            class="identity-avatar"
            src="{{identity.avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="identity-avatar-fallback">
            <text class="identity-avatar-glyph">我</text>
          </view>
        </button>
        <view class="identity-fields">
          <input
            class="field-input identity-nickname"
            type="nickname"
            value="{{identity.nickname}}"
            placeholder="{{t.identityEmpty}}"
            placeholder-class="input-placeholder"
            aria-label="{{t.identityTitle}}"
            bindblur="onNicknameSave"
            bindconfirm="onNicknameSave"
          />
          <text class="field-note">{{t.identityPrivacy}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="card-subtitle">{{t.accountTitle}}</text>
      <view class="account-row">
        <text class="account-state">{{account.signedIn ? t.signedIn : t.signedOut}}</text>
        <text wx:if="{{account.environment}}" class="account-environment">
          {{t.environment}} · {{account.environment}}
        </text>
      </view>
    </view>

    <view class="card">
      <view class="membership-header">
        <text class="card-subtitle membership-label">{{t.membershipTitle}}</text>
        <view
          wx:if="{{membership.status === 'unavailable'}}"
          class="text-action"
          bindtap="onRetryMembership"
          aria-role="button"
        >{{t.retry}}</view>
      </view>
      <text class="card-title">{{membership.text}}</text>
    </view>

    <view class="card">
      <text class="card-subtitle">{{t.usageTitle}}</text>
      <text wx:if="{{usage.status === 'ready'}}" class="card-title">{{usage.turns}}</text>
      <text wx:if="{{usage.status === 'ready'}}" class="card-subtitle">{{usage.tokens}}</text>
      <text wx:elif="{{usage.status === 'unavailable'}}" class="card-subtitle">{{usage.tokens}}</text>
      <text wx:else class="card-subtitle">{{t.usageLoading}}</text>
    </view>

    <view class="section">
      <text class="section-title">{{t.linksTitle}}</text>
      <view
        wx:for="{{links}}"
        wx:key="routeId"
        class="link-row"
        data-url="{{item.url}}"
        data-mode="{{item.mode}}"
        bindtap="onLinkTap"
        aria-role="button"
        aria-label="{{item.label}}"
      >
        <text class="link-glyph">{{item.glyph}}</text>
        <text class="link-label">{{item.label}}</text>
        <text class="link-chevron">›</text>
      </view>
    </view>
  </view>
</view>
