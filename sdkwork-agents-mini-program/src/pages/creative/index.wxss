/* Shared app-bar / chips / buttons / state styles live in app.wxss. */

.section-spaced {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.section-title-inline {
  flex: 1;
  margin-bottom: 0;
}

.text-action {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: var(--accent);
}

.notice {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--primary-subtle);
  color: var(--accent);
  font-size: 24rpx;
  line-height: 1.6;
}

.banner-spaced {
  margin: 16rpx 0 0;
}

.status-compact {
  padding: 40rpx 0;
  text-align: left;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.result-cell {
  box-sizing: border-box;
  width: 50%;
  padding: 8rpx;
}

.result-thumb {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: var(--muted);
}

.result-wide {
  box-sizing: border-box;
  width: 100%;
  padding: 8rpx;
}

.result-video {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
  background: #000000;
}

.result-action {
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  width: 100%;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

/* Run rows: selected row is a blue-tinted fill, never a colored outline. */
.run-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.run-row:active {
  background: var(--muted);
}

.run-row.is-active {
  background: var(--primary-subtle);
}

.run-prompt {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.run-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
