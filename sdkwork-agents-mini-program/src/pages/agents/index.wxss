/* Shared app-bar / search / status / card / segment styles live in app.wxss. */

.load-more {
  margin: 16rpx 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--muted);
  color: var(--accent);
  font-size: 26rpx;
}

.load-more:active {
  background: var(--strong);
}

.load-more.is-disabled {
  color: var(--text-weak);
}
