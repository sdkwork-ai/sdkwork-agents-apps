<view class="page" style="padding-bottom: {{bottomInset}}px;">
  <view class="app-bar" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="app-bar-inner">
      <view class="app-bar-titles app-bar-titles-left">
        <text class="app-bar-title">{{t.title}}</text>
      </view>
      <view class="icon-button" bindtap="onOpenFullVersion">
        <text class="icon-glyph">▤</text>
      </view>
    </view>
  </view>

  <view class="content" style="margin-top: {{headerHeight}}px;">
    <view class="segments">
      <view
        class="segment {{scope === 'mine' ? 'is-active' : ''}}"
        data-scope="mine"
        bindtap="onScopeChange"
      >{{t.myAgents}}</view>
      <view
        class="segment {{scope === 'market' ? 'is-active' : ''}}"
        data-scope="market"
        bindtap="onScopeChange"
      >{{t.market}}</view>
    </view>

    <view wx:if="{{errorMessage}}" class="banner">{{errorMessage}}</view>
    <view wx:elif="{{loading}}" class="status">{{t.loading}}</view>
    <view wx:elif="{{agents.length === 0}}" class="status">{{t.empty}}</view>

    <view wx:else class="list">
      <block wx:for="{{agents}}" wx:key="id">
        <view class="card">
          <text class="card-title">{{item.name}}</text>
          <text wx:if="{{item.description}}" class="card-subtitle">{{item.description}}</text>
        </view>
      </block>
      <view
        wx:if="{{hasMore}}"
        class="load-more {{loadingMore ? 'is-disabled' : ''}}"
        bindtap="loadMoreAgents"
      >{{t.loadMore}}</view>
    </view>
  </view>
</view>
