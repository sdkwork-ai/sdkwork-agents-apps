<view class="page {{themeClass}}" style="padding-bottom: {{bottomInset}}px;">
  <view class="app-bar" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="app-bar-inner">
      <view
        class="app-bar-back"
        bindtap="onBack"
        aria-role="button"
        aria-label="{{t.back}}"
      >‹</view>
      <view class="app-bar-titles app-bar-titles-left">
        <text class="app-bar-title">{{t.title}}</text>
      </view>
      <view
        class="app-bar-avatar"
        bindtap="onOpenProfile"
        aria-role="button"
        aria-label="{{t.profileEntry}}"
      >
        <text class="app-bar-avatar-glyph">我</text>
      </view>
    </view>
  </view>

  <view class="content" style="margin-top: {{headerHeight}}px;">
    <view wx:if="{{status === 'loading'}}" class="status">{{t.loading}}</view>

    <view wx:elif="{{status === 'error'}}" class="state-card">
      <text class="state-title">{{t.loadFailed}}</text>
      <view class="state-actions">
        <view class="secondary-button" bindtap="onRetry" aria-role="button">{{t.retry}}</view>
      </view>
    </view>

    <view wx:elif="{{status === 'unavailable'}}" class="state-card">
      <text class="state-title">{{t.unavailable}}</text>
      <text class="state-detail">{{t.checkoutUnavailable}}</text>
      <view class="state-actions">
        <view class="secondary-button" bindtap="onRetry" aria-role="button">{{t.retry}}</view>
      </view>
    </view>

    <block wx:else>
      <view class="card membership-card">
        <text class="card-subtitle">{{t.currentTitle}}</text>
        <text wx:if="{{summary.active}}" class="card-title">{{summary.levelName}}</text>
        <text wx:else class="card-title">{{t.currentNone}}</text>
        <text wx:if="{{summary.expiresAtText}}" class="card-subtitle">{{summary.expiresAtText}}</text>
      </view>

      <view wx:if="{{pointsBalanceText}}" class="card membership-card">
        <text class="card-subtitle">{{t.pointsTitle}}</text>
        <text class="card-title">{{pointsBalanceText}}</text>
      </view>

      <view class="section">
        <text class="section-title">{{t.plansTitle}}</text>

        <view wx:if="{{!checkoutAvailable}}" class="state-card">
          <text class="state-title">{{t.checkoutUnavailable}}</text>
        </view>

        <view wx:if="{{plans.length === 0}}" class="status status-compact">{{t.plansEmpty}}</view>

        <block wx:for="{{plans}}" wx:key="id">
          <view class="card plan-card">
            <view class="plan-header">
              <text class="card-title plan-name">{{item.name}}</text>
              <text wx:if="{{item.priceText}}" class="plan-price">{{item.priceText}}</text>
            </view>
            <view wx:if="{{item.benefits.length > 0}}" class="plan-benefits">
              <text class="card-subtitle">{{t.benefitsTitle}}</text>
              <text
                wx:for="{{item.benefits}}"
                wx:for-item="benefit"
                wx:key="*this"
                class="plan-benefit"
              >· {{benefit}}</text>
            </view>
            <view
              class="primary-button plan-action {{checkoutAvailable ? '' : 'is-disabled'}}"
              data-id="{{item.id}}"
              bindtap="onCheckout"
              aria-role="button"
            >{{t.checkoutAction}}</view>
          </view>
        </block>
      </view>
    </block>
  </view>
</view>
