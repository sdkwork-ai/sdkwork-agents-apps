.home {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 64rpx 0;
}

.home-avatar {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0f766e;
}

.home-avatar-glyph {
  font-size: 64rpx;
  color: #ffffff;
}

.home-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #0f172a;
}

.home-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
}

.home-entry {
  margin-top: 64rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
}
