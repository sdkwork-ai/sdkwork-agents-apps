.home {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 64rpx 0;
}

.home-avatar {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
}

.home-avatar-glyph {
  font-size: 64rpx;
  color: var(--icon-on-primary);
}

.home-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.home-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

.home-entry {
  margin-top: 64rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--primary-on);
  font-size: 30rpx;
  font-weight: 600;
}

.home-entry:active {
  background: var(--primary-pressed);
}
