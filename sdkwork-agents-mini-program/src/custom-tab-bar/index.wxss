.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
}

.tab-item.is-active {
  color: #0f766e;
}

.tab-symbol {
  font-size: 36rpx;
  line-height: 44rpx;
}

.tab-label {
  font-size: 22rpx;
  line-height: 28rpx;
}
