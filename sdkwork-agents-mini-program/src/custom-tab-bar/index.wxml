<view class="tab-bar">
  <view
    wx:for="{{items}}"
    wx:key="tab"
    class="tab-item {{item.active ? 'is-active' : ''}}"
    data-tab="{{item.tab}}"
    data-url="{{item.url}}"
    bindtap="onTap"
  >
    <text class="tab-symbol">{{item.symbol}}</text>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
