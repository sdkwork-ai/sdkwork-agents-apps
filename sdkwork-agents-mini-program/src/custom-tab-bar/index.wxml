<view class="tab-bar {{themeClass}}">
  <view
    wx:for="{{items}}"
    wx:key="tab"
    class="tab-item {{item.active ? 'is-active' : ''}}"
    data-tab="{{item.tab}}"
    data-url="{{item.url}}"
    bindtap="onTap"
  >
    <view class="tab-symbol">
      <image
        class="tab-symbol-image"
        src="{{item.active ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
    </view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
