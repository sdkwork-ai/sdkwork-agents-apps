page {
  background: #f8fafc;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
}

.status {
  padding: 96rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.status-error {
  color: #dc2626;
}

.list {
  display: flex;
  flex-direction: column;
}

.session {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.session-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.session-title {
  font-size: 28rpx;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.session-actions {
  display: flex;
  align-items: center;
}

.session-action {
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #0f766e;
}

.session-action-danger {
  color: #dc2626;
}
