page {
  background: var(--page);
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
}

.status {
  padding: 96rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-muted);
}

.status-error {
  color: var(--danger);
}

.list {
  display: flex;
  flex-direction: column;
}

/* Session row: flat surface, separated by spacing and tap fill only. */
.session {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.session:active {
  background: var(--muted);
}

.session-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.session-title {
  font-size: 28rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

.session-actions {
  display: flex;
  align-items: center;
}

.session-action {
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--accent);
}

.session-action-danger {
  color: var(--danger);
}
